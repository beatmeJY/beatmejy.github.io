{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sync from origin (folder open)",
      "type": "shell",
      "command": "node .cursor/hooks/sync-on-open.mjs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true,
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
